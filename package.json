{
  "name": "astro-loader-craft-do",
  "version": "0.1.0-alpha.0",
  "description": "Use Craft.do Collections as Astro Content Collections (experimental alpha).",
  "author": "Szymon Chudy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/szymonchudy/astro-loader-craft-do.git"
  },
  "homepage": "https://github.com/szymonchudy/astro-loader-craft-do#readme",
  "bugs": "https://github.com/szymonchudy/astro-loader-craft-do/issues",
  "keywords": ["astro", "astro-loader", "craft", "craft-do", "content-collections"],
  "engines": { "node": "^24.0.0 || ^26.0.0" },
  "publishConfig": { "access": "public", "tag": "alpha", "registry": "https://registry.npmjs.org/" },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm build",
    "test:package": "node scripts/verify-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "dev": "pnpm build && node --env-file=.env.local scripts/run-example.mjs dev",
    "example:build": "pnpm build && node --env-file=.env.local scripts/run-example.mjs build",
    "example:preview": "pnpm --dir examples/basic exec astro preview --host 127.0.0.1"
  },
  "peerDependencies": {
    "astro": "5.9.0 || 5.18.2 || 6.0.0 || 6.4.8 || 7.3.3 || 7.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "astro": "7.3.5",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "sharp": "0.35.4"
  }
}
