---
import { getCollection, render } from 'astro:content';

const articles = await getCollection('articles');
const renderedArticles = await Promise.all(
  articles.map(async (article) => ({ article, ...(await render(article)) })),
);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Craft → Astro</title>
  </head>
  <body>
    <header>
      <p class="eyebrow">CRAFT → ASTRO</p>
      <h1>Your words, on the web.</h1>
      <p>Written in Craft. Rendered with Astro.</p>
      <p class="count">{articles.length} Collection entries</p>
    </header>
    <main>
    {renderedArticles.map(({ article, Content }) => (
      <article id={article.data.properties.slug}>
        <p class="status">Status: {article.data.properties.status}</p>
        <h2>{article.data.title}</h2>
        {article.data.properties.description && <p class="description">{article.data.properties.description}</p>}
        <p class="metadata">
          {article.data.properties.publishedat && <time>{article.data.properties.publishedat} · </time>}
          Tags: {article.data.properties.tags.length}
          {article.data.properties.tags.length > 0 && ` · ${article.data.properties.tags.join(', ')}`}
        </p>
        <div class="content"><Content /></div>
        {!article.body?.trim() && <p class="empty">This entry has no body yet.</p>}
      </article>
    ))}
    </main>
  </body>
</html>

<style>
  :global(body) { margin: 0; background: #f5f3ee; color: #24332c; font-family: system-ui, sans-serif; line-height: 1.65; }
  header, main { max-width: 780px; margin: auto; padding: 0 24px; }
  header { padding-top: 64px; padding-bottom: 28px; }
  .eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .18em; color: #557a64; }
  h1 { font-size: clamp(32px, 6vw, 48px); line-height: 1.15; letter-spacing: -.04em; margin: 16px 0; }
  .count, .metadata, .empty { font-size: 14px; color: #66736a; }
  article { background: white; border: 1px solid #dfE4db; border-radius: 16px; padding: 32px; margin: 0 0 28px; }
  article h2 { font-size: 28px; line-height: 1.25; margin: 10px 0; }
  .status { display: inline-block; background: #eef3e9; color: #45644b; border-radius: 6px; padding: 3px 9px; font-size: 12px; margin: 0; }
  .description { color: #536158; }
  .content { border-top: 1px solid #edf0e9; margin-top: 24px; padding-top: 12px; overflow-wrap: anywhere; }
  .content :global(img) { display: block; max-width: 100%; height: auto; border-radius: 8px; }
  .content :global(pre) { overflow-x: auto; padding: 16px; border-radius: 8px; }
  .content :global(blockquote) { border-left: 3px solid #9cb19c; margin-left: 0; padding-left: 20px; }
  .content :global(aside[data-craft-callout]) { margin: 20px 0; padding: 16px 20px; background: #eef4e9; border: 1px solid #d9e4d1; border-radius: 10px; }
  .content :global(aside[data-craft-callout] > :first-child) { margin-top: 0; }
  .content :global(aside[data-craft-callout] > :last-child) { margin-bottom: 0; }
  .content :global(mark) { background: #fff0aa; }
  .content :global(details) { margin: 16px 0; padding: 12px 16px; background: #f0f5ec; border-radius: 8px; }
  .content :global(summary) { cursor: pointer; font-weight: 600; }
  .content :global(a) { color: #32674d; }
  @media (max-width: 520px) { article { padding: 22px; } header { padding-top: 36px; } }
</style>
